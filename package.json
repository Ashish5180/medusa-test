{
  "name": "backend",
  "version": "0.0.1",
  "description": "Medusa backend API",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "medusa build",
    "build:render": "medusa build && medusa db:migrate",
    "build:railway": "medusa build && node scripts/assert-admin-build.cjs && medusa db:migrate",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "seed": "medusa exec ./src/migration-scripts/initial-data-seed.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.20.1",
    "@medusajs/caching": "2.20.1",
    "@medusajs/cli": "2.20.1",
    "@medusajs/draft-order": "2.20.1",
    "@medusajs/framework": "2.20.1",
    "@medusajs/medusa": "2.20.1",
    "@swc/core": "^1.7.28",
    "ajv": "^8.17.1",
    "jiti": "^2.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.20.1",
    "@medusajs/test-utils": "2.20.1",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "yalc": "^1.0.0-pre.53"
  }
}
